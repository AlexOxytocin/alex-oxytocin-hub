---
//
//  Layout.astro
//  CV Hub
//
//  Created by Alexander Gusarov on 03.03.2026.
//  @AlexOxytocin
//
import '../styles/global.css';
import '../../../../shared/ecosystem-nav.css';
import EcosystemBackground from './EcosystemBackground.astro';
import { getEntry } from 'astro:content';
import { makeT } from '../scripts/t';
import ecosystemNav from '../../../../shared/ecosystem-nav.json';

// Change theme here
//
//import '../styles/themes/vscode.css';
//
// Change theme here

const {
  title = 'CV Hub',
  lang = 'en',
  section = 'main',
  profile = '',
  description,
  ogImage,
  customLangLinks,
} = Astro.props;

// --- Config ---
const langConfig    = await getEntry('languages', 'languages');
const translations  = await getEntry('i18n', 'translations');

const defaultLang = langConfig?.data?.default ?? 'en';
const allLangs    = langConfig?.data?.languages ?? [];
const t = makeT(translations?.data ?? {}, lang);

// --- Meta ---
const repo = import.meta.env.GITHUB_REPOSITORY;
const [owner] = repo ? repo.split('/') : [null, null];
const siteUrl = owner
  ? `https://${owner}.github.io/`
  : 'https://cv.godmodetools.com';

const metaDescription = description ?? t('meta.description');
const metaImage = ogImage ?? `${siteUrl}/og-image-aleksei.png`;
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// --- Navigation ---
function buildHref(profileSlug: string, langId: string): string {
  const segments = [];
  if (profileSlug) segments.push(profileSlug);
  if (langId !== defaultLang) segments.push(langId);
  return `${base}/${segments.join('/')}`;
}

const homeHref     = buildHref(profile, lang);

const isShowcase = Astro.url.pathname.startsWith(`${base}/showcase`);
const showcaseHref = lang === defaultLang
  ? `${base}/showcase`
  : `${base}/showcase/${lang}`;

const langLinks = customLangLinks ?? allLangs.map(l => ({
  id:     l.id,
  label:  l.label,
  href:   buildHref(profile, l.id),
  active: l.id === lang,
}));

const ecosystemLinks = ecosystemNav.sections.map(item => ({
  ...item,
  label: item.labels[lang === 'en' ? 'en' : 'ru'],
  href: item.id === 'experience'
    ? homeHref
    : item.id === 'projects'
      ? showcaseHref
      : item.hrefs[lang === 'en' ? 'en' : 'ru'],
  active: item.id === (isShowcase ? 'projects' : 'experience'),
}));

const ecosystemNavLabel = lang === 'en' ? 'Ecosystem sections' : 'Разделы экосистемы';
const languageLabel = lang === 'en' ? 'Choose language' : 'Выбор языка';
const brandLabel = lang === 'en' ? 'Alex Oxytocin — home' : 'Alex Oxytocin — на главную';

const currentYear = new Date().getFullYear();
const authorGit = 'https://github.com/AlexOxytocin';
const authorGitHubPage = 'https://godmodetools.com';
---

<!doctype html>
<html lang={lang} data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="icon" href={`${base}/favicon.png?v=alex-a-solid-20260818`} type="image/png" sizes="28x28" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Алексей Грищенко — AI-решения, enterprise-архитектура и инженерное лидерство" />
    <meta property="og:locale" content={t('meta.locale')} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content="Алексей Грищенко — AI-решения, enterprise-архитектура и инженерное лидерство" />

    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      const theme = params.get('theme');
      const allowed = ['frosted', 'light', 'nordic', 'peachy'];
      if (theme && allowed.includes(theme)) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = `${document.documentElement.dataset.base}/themes/${theme}.css`;
        document.addEventListener('DOMContentLoaded', () => {
          document.head.appendChild(link);
        });
      }
    </script>
  </head>
  <body>
    <EcosystemBackground />
    <header class="ecosystem-header">
      <div class="ecosystem-nav__inner">
        <a class="ecosystem-nav__brand" href={lang === 'en' ? 'https://godmodetools.com/en/' : 'https://godmodetools.com/'} aria-label={brandLabel}>
          <img class="brand-logo" src="https://godmodetools.com/assets/alex-oxytocin-logo.png?v=official-master-20260817" alt="" width="216" height="30" />
        </a>
        <nav class="ecosystem-nav__links" aria-label={ecosystemNavLabel}>
          {ecosystemLinks.map(item => (
            <a class="ecosystem-nav__link" href={item.href} aria-current={item.active ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="ecosystem-nav__locale" aria-label={languageLabel}>
          {langLinks.map(l => (
            <a href={l.href} lang={l.id} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
          ))}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <span><a href={authorGitHubPage} target="_blank" rel="noopener" class="footer__link">
          Aleksei Grishchenko
        </a> © {currentYear}</span>
        <a href={authorGit} target="_blank" rel="noopener" class="footer__link">
          GitHub
        </a>
      </div>
    </footer>
  </body>
</html>
