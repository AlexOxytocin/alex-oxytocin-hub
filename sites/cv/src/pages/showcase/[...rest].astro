---
//
//  showcase/[...rest].astro
//  CV Hub — Dynamic showcase routes
//
//  Handles:
//    /showcase/en              → showcase list in EN (non-default lang)
//    /showcase/cv-hub          → project case study, default lang
//    /showcase/cv-hub/en       → project case study, EN
//
//  Case study YAMLs live on disk:
//    public/media/projects/{slug}/{slug_underscored}_{lang}.yaml
//    e.g. public/media/projects/cv-hub/cv_hub_ru.yaml
//
//  Created by Alexander Gusarov on 30.03.2026.
//  @AlexOxytocin
//

import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'yaml';
import { getEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectPage from '../../components/ProjectPage.astro';
import { makeT } from '../../scripts/t';

const MEDIA_DIR = path.join(process.cwd(), 'public/media/projects');

// cv-hub → cv_hub
function toPrefix(slug: string) {
  return slug.replace(/-/g, '_');
}

// Load YAML from disk with lang fallback
function loadProjectYaml(slug: string, lang: string, defaultLang: string) {
  const dir      = path.join(MEDIA_DIR, slug);
  const prefix   = toPrefix(slug);
  const primary  = path.join(dir, `${prefix}_${lang}.yaml`);
  const fallback = path.join(dir, `${prefix}_${defaultLang}.yaml`);
  try {
    if (fs.existsSync(primary))  return parse(fs.readFileSync(primary, 'utf8'));
    if (fs.existsSync(fallback)) return parse(fs.readFileSync(fallback, 'utf8'));
  } catch {}
  return null;
}

// Slugs that have at least one lang yaml
function getSlugsWithYaml(langIds: string[]): string[] {
  if (!fs.existsSync(MEDIA_DIR)) return [];
  return fs.readdirSync(MEDIA_DIR).filter((name) => {
    const dir    = path.join(MEDIA_DIR, name);
    const prefix = toPrefix(name);
    if (!fs.statSync(dir).isDirectory()) return false;
    return langIds.some((l) => fs.existsSync(path.join(dir, `${prefix}_${l}.yaml`)));
  });
}

export async function getStaticPaths() {
  const langCfg     = await getEntry('languages', 'languages');
  const defaultLang: string = langCfg?.data?.default ?? 'ru';
  const langs: { id: string; label: string }[] = langCfg?.data?.languages ?? [];
  const langIds = langs.map((l) => l.id);

  // Helpers redefined inside getStaticPaths — required by Astro's isolated context
  const MEDIA_DIR = path.join(process.cwd(), 'public/media/projects');
  function _toPrefix(s: string) { return s.replace(/-/g, '_'); }
  function _loadYaml(slug: string, lang: string) {
    const dir     = path.join(MEDIA_DIR, slug);
    const prefix  = _toPrefix(slug);
    const primary = path.join(dir, `${prefix}_${lang}.yaml`);
    const fallback= path.join(dir, `${prefix}_${defaultLang}.yaml`);
    try {
      if (fs.existsSync(primary))  return parse(fs.readFileSync(primary, 'utf8'));
      if (fs.existsSync(fallback)) return parse(fs.readFileSync(fallback, 'utf8'));
    } catch {}
    return null;
  }
  function _getSlugs(): string[] {
    // The starter ships example case studies that belong to its original author.
    // Keep this empty until Aleksei's own public case studies are ready.
    return [];
  }

  const paths: any[] = [];

  // ── 1. Showcase list for non-default languages ─────────────────────────
  for (const lang of langs.filter((l) => l.id !== defaultLang)) {
    paths.push({
      params: { rest: lang.id },
      props:  { kind: 'list', lang: lang.id, defaultLang },
    });
  }

  // ── 2. Project case study pages ────────────────────────────────────────
  const slugs = _getSlugs();

  for (const slug of slugs) {
    // Default lang → /showcase/{slug}
    if (_loadYaml(slug, defaultLang)) {
      paths.push({
        params: { rest: slug },
        props:  { kind: 'project', lang: defaultLang, defaultLang, slug },
      });
    }

    // Non-default langs → /showcase/{slug}/{lang}
    for (const lang of langs.filter((l) => l.id !== defaultLang)) {
      if (!_loadYaml(slug, lang.id)) continue;
      paths.push({
        params: { rest: `${slug}/${lang.id}` },
        props:  { kind: 'project', lang: lang.id, defaultLang, slug },
      });
    }
  }

  return paths;
}

// ── Runtime ────────────────────────────────────────────────────────────────

const { kind, lang, defaultLang, slug } = Astro.props;

const langCfg    = await getEntry('languages', 'languages');
const allLangs: { id: string; label: string }[] = langCfg?.data?.languages ?? [];
const langIds    = allLangs.map((l) => l.id);
const base       = import.meta.env.BASE_URL.replace(/\/$/, '');

const translations = await getEntry('i18n', 'translations');
const t = makeT(translations?.data ?? {}, lang);

// ── Showcase list ──────────────────────────────────────────────────────────

let projects: any[] = [];
let groups: any[] = [];
let approaches: any[] = [];
let intro = '';
let projectSlugsWithPages = new Set<string>();

  if (kind === 'list') {
  try {
    const entry = await getEntry('showcase', `projects_${lang}`);
    projects = entry?.data?.projects ?? [];
    groups = entry?.data?.groups ?? [];
    approaches = entry?.data?.approaches ?? [];
    intro = entry?.data?.intro ?? '';
  } catch {}

  projects = [...projects].sort((a, b) => {
    const ao = Number.isFinite(Number(a?.order)) ? Number(a.order) : 9999;
    const bo = Number.isFinite(Number(b?.order)) ? Number(b.order) : 9999;
    if (ao !== bo) return ao - bo;
    return String(a?.name ?? '').toLowerCase().localeCompare(String(b?.name ?? '').toLowerCase());
  });

  projectSlugsWithPages = new Set(getSlugsWithYaml(langIds));
}

// LCP optimization: first card with an actual image/gif cover loads eagerly.
const hasImageCover = (p: any) => {
  const m = Array.isArray(p?.media) ? p.media : [];
  const fm = m.find((x: any) => x?.featured) ?? m[0];
  return fm && (fm.type === 'image' || fm.type === 'gif');
};
const eagerIdx = projects.findIndex(hasImageCover);

const showcaseLangLinks = kind === 'list'
  ? allLangs.map(l => ({
      id:     l.id,
      label:  l.label,
      href:   l.id === defaultLang ? `${base}/showcase` : `${base}/showcase/${l.id}`,
      active: l.id === lang,
    }))
  : undefined;

// ── Project page ───────────────────────────────────────────────────────────

const projectData = kind === 'project' ? loadProjectYaml(slug, lang, defaultLang) : null;

const showcaseHref = lang === defaultLang
  ? `${base}/showcase`
  : `${base}/showcase/${lang}`;

const langLinks = kind === 'project'
  ? allLangs
      .filter((l) => loadProjectYaml(slug, l.id, defaultLang) !== null)
      .map((l) => ({
          id:     l.id,
          label:  l.label,
          href:   l.id === defaultLang
                    ? `${base}/showcase/${slug}`
                    : `${base}/showcase/${slug}/${l.id}`,
          active: l.id === lang,
        }))
  : [];
---

{kind === 'list' ? (
  <Layout title={t('showcase.page_title')} lang={lang} section="showcase" profile="" customLangLinks={showcaseLangLinks}>
    <section class="container">
      {approaches.length > 0 && (
        <section class="approaches" id="approaches">
          <header class="showcase__group-header">
            <h1>{lang === 'ru' ? 'Как я работаю' : 'How I work'}</h1>
            <p>{lang === 'ru' ? 'Принципы, которые повторяются в клиентских и собственных проектах.' : 'Principles repeated across client work and original products.'}</p>
          </header>
          <div class="approaches__grid">
            {approaches.map((approach: any, index: number) => (
              <article class="approach-card">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h2>{approach.title}</h2>
                <p>{approach.description}</p>
              </article>
            ))}
          </div>
        </section>
      )}
      {projects.length === 0 && (
        <article class="card"><p class="muted">{t('showcase.empty')}</p></article>
      )}

      {groups.map((group: any) => {
        const groupProjects = group.project_slugs
          .map((projectSlug: string) => projects.find((p: any) => p.slug === projectSlug))
          .filter(Boolean);
        if (groupProjects.length === 0) return null;
        return (
          <section class="showcase__group" id={group.id}>
            <header class="showcase__group-header">
              <h2>{group.title}</h2>
              {group.description && <p>{group.description}</p>}
            </header>
            <div class="grid">
        {groupProjects.map((p: any) => (
          <ProjectCard
            project={p}
            eager={projects.indexOf(p) === eagerIdx}
            t={{
              platforms: t('showcase.platforms'),
              stack:     t('showcase.stack'),
              tags:      t('showcase.tags'),
              featured:  t('showcase.featured'),
            }}
          />
        ))}
            </div>
          </section>
        );
      })}
    </section>
  </Layout>
) : (
  <ProjectPage
    lang={lang}
    data={projectData}
    langLinks={langLinks}
    showcaseHref={showcaseHref}
  />
)}

<style>
  .showcase__group::before,
  .approaches::before {
    content: "";
    width: 4px;
    position: absolute;
    inset: 14px auto 14px 0;
    border-radius: 0 4px 4px 0;
    background: var(--group-accent, linear-gradient(180deg, var(--accent), var(--accent-2)));
    box-shadow: 0 0 18px color-mix(in srgb, var(--group-accent, var(--accent)) 52%, transparent);
  }
  .showcase__group-header p { color: var(--muted); max-width: 720px; line-height: 1.55; }
  .showcase__group,
  .approaches {
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
    padding: var(--card-pad-y) var(--card-pad-x);
    border: 1px solid var(--glass-line);
    border-radius: var(--r-lg);
    background: var(--glass);
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px) saturate(112%);
    -webkit-backdrop-filter: blur(10px) saturate(112%);
    scroll-margin-top: 90px;
  }
  .showcase__group:nth-of-type(4n + 1) { --group-accent: #25e3d3; }
  .showcase__group:nth-of-type(4n + 2) { --group-accent: #5aa7ff; }
  .showcase__group:nth-of-type(4n + 3) { --group-accent: #8668ff; }
  .showcase__group:nth-of-type(4n) { --group-accent: #d15cff; }
  .showcase__group-header {
    position: relative;
    margin-bottom: 18px;
    padding: 0;
  }
  .showcase__group-header h2 { margin: 0 0 8px; font-size: clamp(24px, 4vw, 34px); line-height: 1.2; }
  .showcase__group-header p { margin: 0; }
  .showcase__group > .grid,
  .approaches__grid { position: relative; z-index: 1; }
  .approaches { --group-accent: #25e3d3; margin-top: 14px; }
  .approaches__grid { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .approach-card { padding: var(--card-pad-y) var(--card-pad-x); border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--card-bg); }
  .approach-card span { color: var(--accent); font-size: 12px; font-weight: 800; letter-spacing: .14em; }
  .approach-card h2 { margin: 10px 0 8px; font-size: 20px; line-height: 1.3; }
  .approach-card p { margin: 0; color: var(--muted); line-height: 1.55; }
  @media (max-width: 680px) {
    .showcase__group-header { padding: 0; }
    .approaches__grid { grid-template-columns: 1fr; }
  }
</style>
