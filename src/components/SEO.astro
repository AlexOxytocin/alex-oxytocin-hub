---
import { localeDefinition, publishedLocales, routePath, type CrawlDirective, type Locale, type RouteId } from '../config/routes';
import { siteConfig } from '../config/site';

interface Props {
  locale: Locale;
  route?: RouteId | undefined;
  title: string;
  description: string;
  robots?: CrawlDirective | undefined;
  path?: string | undefined;
  alternatePaths?: Partial<Record<Locale, string>> | undefined;
}

const { locale, route, title, description, robots, path, alternatePaths } = Astro.props;
const definition = localeDefinition(locale);
const canonicalPath = path ?? (route ? routePath(locale, route) : undefined);
const canonical = canonicalPath ? new URL(canonicalPath, siteConfig.url).href : undefined;
const alternates = route
  ? publishedLocales.map((alternate) => ({
      locale: alternate,
      href: new URL(alternatePaths?.[alternate.id] ?? routePath(alternate.id, route), siteConfig.url).href,
    }))
  : [];
const fullTitle = `${title} — ${siteConfig.name}`;
const socialImage = new URL(siteConfig.socialImage, siteConfig.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{robots && robots !== 'index, follow' && <meta name="robots" content={robots} />}
{canonical && <link rel="canonical" href={canonical} />}
{alternates.map(({ locale: alternate, href }) => (
  <link rel="alternate" hreflang={alternate.htmlLang} href={href} />
))}
{route && <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths?.ru ?? routePath('ru', route), siteConfig.url).href} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={socialImage} />
<meta property="og:locale" content={definition.ogLocale} />
{alternates.filter(({ locale: alternate }) => alternate.id !== locale).map(({ locale: alternate }) => (
  <meta property="og:locale:alternate" content={alternate.ogLocale} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
