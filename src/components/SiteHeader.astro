---
import { localeDefinition, localeRouteEntries, routeEntries, type Locale, type RouteId } from '../config/routes';
import { interfaceCopy, navigationLabel } from '../i18n/ui';
import { legacyHomeTheme } from '../theme/legacy-home';
import { Image } from 'astro:assets';

interface Props {
  locale: Locale;
  route: RouteId;
  localePaths?: Partial<Record<Locale, string>> | undefined;
  variant?: 'legacy-home' | 'site-shell' | undefined;
}

const { locale, route, localePaths, variant } = Astro.props;
const copy = interfaceCopy(locale);
const currentLocale = localeDefinition(locale);
const isLegacyHome = variant === 'legacy-home';
const { brandLogo } = legacyHomeTheme.assets;
const navigationEntries = routeEntries(locale);
const homeHref = navigationEntries.find((entry) => entry.route === 'home')!.href;
const localeEntries = localeRouteEntries(route).map((entry) => ({
  ...entry,
  href: localePaths?.[entry.locale.id] ?? entry.href,
}));
const switcherEntries = isLegacyHome
  ? [...localeEntries].sort((left, right) => left.locale.id === 'en' ? -1 : left.locale.id === 'ru' ? 1 : left.locale.label.localeCompare(right.locale.label))
  : localeEntries;
---

<header class="site-header" data-variant={variant}>
  <a class="site-brand" href={homeHref} aria-label={isLegacyHome ? copy.homeBrand : 'God Mode Tools'}>
    {isLegacyHome ? (
      <Image
        src={brandLogo}
        format="webp"
        widths={[154, 176, 196]}
        sizes="(max-width: 390px) 154px, (max-width: 900px) 176px, 196px"
        alt=""
        loading="eager"
        decoding="async"
      />
    ) : (
      <>
        <span aria-hidden="true">GM</span>
        <strong>God Mode Tools</strong>
      </>
    )}
  </a>

  <nav aria-label={copy.navigation}>
    <ul class="site-navigation">
      {navigationEntries.map((entry) => (
        <li>
          <a href={entry.href} aria-current={entry.route === route ? 'page' : undefined}>
            {navigationLabel(locale, entry.route)}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="locale-switcher" aria-label={copy.languages}>
    {switcherEntries.map(({ locale: alternate, href }) => (
      <a
        href={href}
        lang={alternate.htmlLang}
        aria-current={alternate.id === currentLocale.id ? 'page' : undefined}
      >
        {alternate.label}
      </a>
    ))}
  </div>
</header>
