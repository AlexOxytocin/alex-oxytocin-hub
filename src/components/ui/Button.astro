---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const { href, variant = 'primary', type = 'button', class: className } = Astro.props;
---

{href ? (
  <a class:list={['button', className]} data-variant={variant} href={href}>
    <slot />
  </a>
) : (
  <button class:list={['button', className]} data-variant={variant} type={type}>
    <slot />
  </button>
)}
