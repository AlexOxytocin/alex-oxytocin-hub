---
import type { PageContent } from '../content/pages';
import type { Locale, SectionRouteId } from '../config/routes';
import { getCv, getProfiles, getProjects } from '../content/site-content';
import CommunityPage from './pages/CommunityPage.astro';
import ExperiencePage from './pages/ExperiencePage.astro';
import LearningPage from './pages/LearningPage.astro';
import ProjectsPage from './pages/ProjectsPage.astro';

interface Props {
  locale: Locale;
  route: SectionRouteId;
  content: PageContent;
}

const { locale, route, content } = Astro.props;
const cv = route === 'experience' ? await getCv(locale) : undefined;
const profiles = route === 'experience' ? await getProfiles() : undefined;
const projects = route === 'projects' ? await getProjects(locale) : undefined;
---

{content.route === 'experience' && cv && profiles && <ExperiencePage locale={locale} content={content} cv={cv} profiles={profiles} />}
{content.route === 'projects' && projects && <ProjectsPage locale={locale} content={content} collection={projects} />}
{content.route === 'learning' && <LearningPage locale={locale} content={content} />}
{content.route === 'community' && <CommunityPage locale={locale} content={content} />}
