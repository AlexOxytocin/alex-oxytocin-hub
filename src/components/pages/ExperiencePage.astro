---
import type { PageContent } from '../../content/pages';
import type { CvContent, ProfileDefinition } from '../../content/site-content';
import { profilePath, type Locale } from '../../config/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
  content: Extract<PageContent, { route: 'experience' }>;
  cv: CvContent;
  profiles: ProfileDefinition[];
  profileSlug?: string;
}

const { locale, content, cv, profiles, profileSlug = '' } = Astro.props;
const path = profilePath(locale, profileSlug);
const alternatePaths = { ru: profilePath('ru', profileSlug), en: profilePath('en', profileSlug) };
const fileStem = `resume_${locale}${profileSlug ? `_${profileSlug}` : ''}`;
const localizedProfileLabel = (profile: ProfileDefinition) => profile.slug === 'java'
  ? (locale === 'en' ? 'Java Architect' : 'Java-архитектор')
  : (locale === 'en' ? 'AI Solutions' : 'ИИ-решения');
---

<BaseLayout locale={locale} route="experience" title={`${cv.name} — ${cv.title}`} description={cv.summary || content.description} path={path} alternatePaths={alternatePaths}>
  <Section class="page-hero page-hero--short">
    <Container>
      <div class="reading-column">
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{cv.title}</h1>
        <p class="intro">{cv.summary}</p>
        <div class="contact-row">
          {cv.contacts.map((contact) => <a href={contact.url} rel="me noopener">{contact.label} ↗</a>)}
        </div>
      </div>
    </Container>
  </Section>

  <Section class="section-compact">
    <Container>
      <nav class="profile-switcher" aria-label={content.profileLabel}>
        {profiles.map((profile) => (
          <a href={profilePath(locale, profile.slug)} aria-current={profile.slug === profileSlug ? 'page' : undefined}>{localizedProfileLabel(profile)}</a>
        ))}
      </nav>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="content-columns">
        <div>
          <h2>{content.achievementsLabel}</h2>
          <ul class="feature-list feature-list--dense">{cv.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
        </div>
        <aside class="download-panel">
          <h2>{content.downloadsLabel}</h2>
          <p>{content.downloadNote}</p>
          <div class="download-links">
            {['pdf', 'docx', 'txt'].map((extension) => <a class="button" data-variant="secondary" href={`/downloads/${fileStem}.${extension}`} download>{extension.toUpperCase()}</a>)}
          </div>
        </aside>
      </div>
    </Container>
  </Section>

  <Section class="section-tinted">
    <Container>
      <h2>{content.skillsLabel}</h2>
      <div class="skill-grid">
        {cv.skills.map((skill) => <article class="content-card"><h3>{skill.group}</h3><p>{skill.items.join(' · ')}</p></article>)}
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <h2>{content.historyLabel}</h2>
      <div class="timeline">
        {cv.experience.map((job) => (
          <article class="timeline-item">
            <div><p class="eyebrow">{job.period}</p><h3>{job.role}</h3><p class="timeline-company">{job.company}</p></div>
            <div><ul>{job.description.map((line) => <li>{line}</li>)}</ul><p class="tag-line">{job.stack.join(' · ')}</p></div>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
