---
import type { PageContent } from '../../content/pages';
import type { ProjectCollection } from '../../content/site-content';
import { projectPath, type Locale } from '../../config/routes';
import { showcaseImage } from '../../assets/showcase';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
  content: Extract<PageContent, { route: 'projects' }>;
  collection: ProjectCollection;
}

const { locale, content, collection } = Astro.props;
const projects = [...collection.projects]
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999))
  .map((project) => {
    const media = project.media.find((item) => item.featured) ?? project.media[0];
    return { project, media, image: media?.src ? showcaseImage(media.src) : undefined };
  });
---

<BaseLayout locale={locale} route="projects" title={content.title} description={content.description}>
  <Section class="page-hero page-hero--short">
    <Container><div class="reading-column"><p class="eyebrow">{content.eyebrow}</p><h1>{content.heading}</h1><p class="intro">{content.intro}</p></div></Container>
  </Section>
  <Section class="section-tinted">
    <Container>
      <h2>{content.approachesLabel}</h2>
      <div class="approach-grid">{collection.approaches.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
    </Container>
  </Section>
  <Section>
    <Container>
      <h2>{content.selectedLabel}</h2>
      <div class="project-grid">
        {projects.map(({ project, media, image }) => (
          <article class="project-card">
            {image && <Picture src={image} formats={['avif', 'webp']} widths={[320, 480, 720]} sizes="(max-width: 40rem) calc(100vw - 2rem), (max-width: 72rem) calc(50vw - 3rem), 34rem" alt={media?.alt ?? ''} loading="lazy" decoding="async" quality={68} />}
            <div class="project-card__body">
              <p class="eyebrow">{project.category || project.role} · {project.year}</p>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <p class="tag-line">{project.tags.join(' · ')}</p>
              <a class="text-link" href={projectPath(locale, project.slug)}>{content.detailsLabel} →</a>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
