---
import type { PageContent } from '../../content/pages';
import type { Locale } from '../../config/routes';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props { locale: Locale; content: Extract<PageContent, { route: 'learning' }>; }
const { locale, content } = Astro.props;
---

<BaseLayout locale={locale} route="learning" title={content.title} description={content.description}>
  <Section class="page-hero">
    <Container><div class="reading-column"><p class="eyebrow">{content.eyebrow}</p><h1>{content.heading}</h1><p class="intro">{content.intro}</p><div class="action-row"><a class="button" href="#contact">{content.primaryCta}</a><a class="text-link" href="#examples">{content.examplesCta} ↓</a></div><ul class="inline-points">{content.heroPoints.map((point) => <li>{point}</li>)}</ul></div></Container>
  </Section>
  <Section class="section-tinted">
    <Container><header class="section-heading"><p class="eyebrow">{content.comparisonLabel}</p><h2>{content.comparisonHeading}</h2></header><div class="comparison-grid">{content.comparison.map((column) => <article class="content-card"><p class="eyebrow">{column.label}</p><h3>{column.title}</h3><ol>{column.steps.map((step) => <li>{step}</li>)}</ol></article>)}</div></Container>
  </Section>
  <Section id="examples">
    <Container><header class="section-heading"><p class="eyebrow">{content.examplesLabel}</p><h2>{content.examplesHeading}</h2><p class="intro">{content.examplesIntro}</p></header>{content.scenarioGroups.map((group) => <section class="scenario-group"><p class="eyebrow">{group.label}</p><h3>{group.title}</h3><div class="scenario-grid">{group.items.map((item, index) => <article class="content-card"><span class="card-number">{String(index + 1).padStart(2, '0')}</span><h4>{item.title}</h4><p>{item.description}</p><p class="benefit"><strong>{locale === 'en' ? 'What changes' : 'Что меняется'}</strong>{item.benefit}</p></article>)}</div></section>)}</Container>
  </Section>
  <Section class="section-tinted">
    <Container><header class="section-heading"><p class="eyebrow">{content.processLabel}</p><h2>{content.processHeading}</h2><p class="intro">{content.processIntro}</p></header><ol class="process-grid">{content.process.map((step) => <li><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></Container>
  </Section>
  <Section id="contact">
    <Container><div class="contact-grid"><div><p class="eyebrow">{content.contactLabel}</p><h2>{content.contactHeading}</h2><p class="intro">{content.contactIntro}</p><ul class="feature-list feature-list--dense">{content.contactPoints.map((point) => <li>{point}</li>)}</ul></div><aside class="download-panel"><a class="button" href={siteConfig.social.telegram}>{content.primaryCta} ↗</a><a class="text-link" href={siteConfig.social.linkedin}>LinkedIn ↗</a><p>{content.safetyNote}</p></aside></div></Container>
  </Section>
</BaseLayout>
