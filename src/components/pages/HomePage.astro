---
import type { PageContent } from '../../content/pages';
import type { Locale } from '../../config/routes';
import { interfaceCopy } from '../../i18n/ui';
import { legacyHomeTheme } from '../../theme/legacy-home';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBackdrop from './home/HomeBackdrop.astro';
import HomeDirectionCard from './home/HomeDirectionCard.astro';
import HomeEvidence from './home/HomeEvidence.astro';
import HomeHeroIntro from './home/HomeHeroIntro.astro';
import HomeHeroSummary from './home/HomeHeroSummary.astro';
import '../../styles/themes/legacy-home.css';
import '../../styles/home.css';

type HomeContent = Extract<PageContent, { route: 'home' }>;

interface Props {
  locale: Locale;
  content: HomeContent;
  geometryReference: HomeContent;
}

const { locale, content, geometryReference } = Astro.props;
const copy = interfaceCopy(locale);
const { heroImage } = legacyHomeTheme.assets;
const referenceDirections = new Map(geometryReference.directions.map((direction) => [direction.route, direction]));
---

<BaseLayout
  locale={locale}
  route="home"
  title={content.title}
  description={content.description}
  theme="legacy-home"
>
  <HomeBackdrop slot="backdrop" />

  <section class="home-hero" id="top">
    <div class="home-hero__primary">
      <div class="home-hero__media" aria-hidden="true">
        <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt="" decoding="async" fetchpriority="high" />
      </div>
      <div class="home-hero__copy">
        <div class="home-hero__intro home-locale-stack">
          <HomeHeroIntro content={content} />
          <HomeHeroIntro content={geometryReference} hidden />
        </div>
        <div class="home-hero__body home-locale-stack">
          <HomeHeroSummary content={content} />
          <HomeHeroSummary content={geometryReference} hidden />
        </div>
      </div>
    </div>

    <div class="home-hero__evidence home-locale-stack" aria-label={copy.homeEvidence}>
      <HomeEvidence content={content} />
      <HomeEvidence content={geometryReference} hidden />
    </div>
  </section>

  <section class="home-directions" id="directions" aria-label={copy.homeDirections}>
    <div class="home-direction-grid">
      {content.directions.map((direction) => (
        <HomeDirectionCard
          locale={locale}
          direction={direction}
          geometryReference={referenceDirections.get(direction.route) ?? direction}
        />
      ))}
    </div>
  </section>
</BaseLayout>
