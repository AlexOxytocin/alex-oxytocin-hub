---
import type { PageContent } from '../../content/pages';
import type { ProjectContent } from '../../content/site-content';
import { projectPath, routePath, type Locale } from '../../config/routes';
import { showcaseImage } from '../../assets/showcase';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
  content: Extract<PageContent, { route: 'projects' }>;
  project: ProjectContent;
}

const { locale, content, project } = Astro.props;
const path = projectPath(locale, project.slug);
const alternatePaths = { ru: projectPath('ru', project.slug), en: projectPath('en', project.slug) };
const localizedLink = (url: string) => {
  try {
    const host = new URL(url).hostname;
    if (host === 'allo.godmodetools.com') return routePath(locale, 'community');
    if (host === 'ai.godmodetools.com') return routePath(locale, 'learning');
    if (host === 'cv.godmodetools.com') return routePath(locale, 'experience');
  } catch {}
  return url;
};
const media = project.media.filter((item) => item.src).map((item) => ({ ...item, image: showcaseImage(item.src) }));
---

<BaseLayout locale={locale} route="projects" title={project.name} description={project.description} path={path} alternatePaths={alternatePaths}>
  <Section class="page-hero page-hero--short">
    <Container>
      <div class="reading-column">
        <a class="back-link" href={routePath(locale, 'projects')}>← {content.backLabel}</a>
        <p class="eyebrow">{project.role} · {project.year}</p>
        <h1>{project.name}</h1>
        <p class="intro">{project.description}</p>
      </div>
    </Container>
  </Section>
  <Section class="section-compact">
    <Container>
      {media.length > 0 && <div class="project-media">{media.map((item) => <Picture src={item.image} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 72rem) calc(100vw - 2rem), 72rem" alt={item.alt} loading="eager" decoding="async" quality={72} />)}</div>}
      <div class="project-facts">
        <div><h2>{locale === 'en' ? 'Platforms' : 'Платформы'}</h2><p>{project.platforms.join(' · ')}</p></div>
        <div><h2>{locale === 'en' ? 'Stack' : 'Стек'}</h2><p>{project.stack.join(' · ')}</p></div>
        {project.metrics.length > 0 && <div><h2>{locale === 'en' ? 'Evidence' : 'Результаты'}</h2>{project.metrics.map((metric) => <p><strong>{metric.value}</strong>{metric.label && ` · ${metric.label}`}</p>)}</div>}
      </div>
      {project.links.length > 0 && <div class="contact-row">{project.links.filter((link) => link.url).map((link) => <a href={localizedLink(link.url)} rel="noopener">{link.label} ↗</a>)}</div>}
    </Container>
  </Section>
</BaseLayout>
