---
import type { Locale } from '../config/routes';
import { siteConfig } from '../config/site';
import { interfaceCopy } from '../i18n/ui';
import Container from './ui/Container.astro';

interface Props {
  locale: Locale;
  variant?: 'legacy-home' | undefined;
}

const { locale, variant } = Astro.props;
const copy = interfaceCopy(locale);
const isLegacyHome = variant === 'legacy-home';
const links = isLegacyHome
  ? [
      ['GitHub', siteConfig.social.github],
      ['LinkedIn', siteConfig.social.linkedin],
      ['Telegram', siteConfig.social.telegram],
    ]
  : [
      ['GitHub', siteConfig.social.github],
      ['Telegram', siteConfig.social.telegram],
      ['LinkedIn', siteConfig.social.linkedin],
    ];
---

<footer class="site-footer" data-variant={variant}>
  <Container class="site-footer__inner">
    <div>
      <p>{isLegacyHome ? copy.homeFooter : copy.footer}</p>
      {!isLegacyHome && <p>{copy.rights}</p>}
    </div>
    <nav class="site-footer__links" aria-label={copy.social}>
      {links.map(([label, href]) => <a href={href} rel="me noopener">{label}</a>)}
    </nav>
  </Container>
</footer>
