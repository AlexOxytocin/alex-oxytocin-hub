---
import type { GetStaticPaths } from 'astro';
import ExperiencePage from '../../../components/pages/ExperiencePage.astro';
import { getPublishedPage } from '../../../content/pages';
import { getCv, getProfiles, type CvContent, type ProfileDefinition } from '../../../content/site-content';
import { publishedLocales, type Locale } from '../../../config/routes';

export const getStaticPaths = (async () => {
  const profiles = await getProfiles();
  return Promise.all(publishedLocales.flatMap(({ id }) => profiles.filter((profile) => profile.slug).map(async (profile) => ({
    params: { locale: id, profile: profile.slug },
    props: {
      locale: id,
      profileSlug: profile.slug,
      content: await getPublishedPage(id, 'experience'),
      cv: await getCv(id, profile.slug),
      profiles,
    },
  }))));
}) satisfies GetStaticPaths;

const { locale, content, cv, profiles, profileSlug } = Astro.props as {
  locale: Locale;
  content: Extract<Awaited<ReturnType<typeof getPublishedPage>>, { route: 'experience' }>;
  cv: CvContent;
  profiles: ProfileDefinition[];
  profileSlug: string;
};
---

<ExperiencePage locale={locale} content={content} cv={cv} profiles={profiles} profileSlug={profileSlug} />
