---
import type { GetStaticPaths } from 'astro';
import PageShell from '../../components/PageShell.astro';
import { getPublishedPage, type PageContent } from '../../content/pages';
import {
  publishedLocales,
  routeSegments,
  sectionRouteIds,
  type Locale,
  type SectionRouteId,
} from '../../config/routes';

export const getStaticPaths = (async () => {
  const pages = await Promise.all(publishedLocales.flatMap(({ id }) => (
    sectionRouteIds.map(async (route) => ({
      params: { locale: id, section: routeSegments[route] },
      props: { locale: id, route, content: await getPublishedPage(id, route) },
    }))
  )));
  return pages;
}) satisfies GetStaticPaths;

const { locale, route, content } = Astro.props as {
  locale: Locale;
  route: SectionRouteId;
  content: PageContent;
};
---

<PageShell locale={locale} route={route} content={content} />
