---
import type { GetStaticPaths } from 'astro';
import PageShell from '../../components/PageShell.astro';
import {
  publishedLocales,
  routeSegments,
  sectionRouteIds,
  type Locale,
  type SectionRouteId,
} from '../../config/routes';

export const getStaticPaths = (async () => {
  return publishedLocales.flatMap(({ id }) => (
    sectionRouteIds.map((route) => ({
      params: { locale: id, section: routeSegments[route] },
      props: { locale: id, route },
    }))
  ));
}) satisfies GetStaticPaths;

const { locale, route } = Astro.props as {
  locale: Locale;
  route: SectionRouteId;
};
---

<PageShell locale={locale} route={route} />
