---
import type { GetStaticPaths } from 'astro';
import HomePage from '../../components/pages/HomePage.astro';
import { getPublishedPage, type PageContent } from '../../content/pages';
import { publishedLocales, type Locale } from '../../config/routes';

export const getStaticPaths = (async () => Promise.all(
  publishedLocales.map(async ({ id }) => {
    const [content, geometryReference] = await Promise.all([
      getPublishedPage(id, 'home'),
      getPublishedPage('ru', 'home'),
    ]);
    return {
      params: { locale: id },
      props: { locale: id, content, geometryReference },
    };
  }),
)) satisfies GetStaticPaths;

type HomeContent = Extract<PageContent, { route: 'home' }>;
const { locale, content, geometryReference } = Astro.props as {
  locale: Locale;
  content: HomeContent;
  geometryReference: HomeContent;
};
---

<HomePage locale={locale} content={content} geometryReference={geometryReference} />
