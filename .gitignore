# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
__pycache__/
*.py[cod]
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
**/dist/
/release/
/.astro/
/public/cv/
/public/downloads/
/*.tar.gz
/outputs/
/work/

# Local visual QA artifacts
/.codex-*.png
/.qa-*.png
**/.codex-dist-lock-backup-*/
/tests/fixtures/tls/*.pem
